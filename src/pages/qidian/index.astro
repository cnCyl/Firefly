---
import { Icon } from "astro-icon/components";
import BookCard from "@/components/pages/qidian/BookCard.astro";
import { qidianConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	getQidianBookCount,
	getQidianBookshelf,
	getQidianRecommendedUrls,
	isGroupTextMode,
	isQidianBookshelfEmpty,
	isReadToLatest,
} from "@/utils/qidian-utils";

// 页面开关：siteConfig.pages.qidian 或 qidianConfig.enable 关闭时返回 404
if (!siteConfig.pages.qidian || !qidianConfig.enable) {
	return Astro.redirect("/404/");
}

const title = qidianConfig.title || i18n(I18nKey.qidian);
const description = qidianConfig.description || i18n(I18nKey.qidianDescription);

// 书架数据（构建时由 fetch-qidian-bookshelf.ts 生成）
const bookshelf = getQidianBookshelf();
const empty = isQidianBookshelfEmpty(bookshelf);
const totalCount = getQidianBookCount(bookshelf);
const groups = empty ? [] : bookshelf.groups;

// 持久化推荐 URL 集合（qidian-recommend.json + 书籍 recommend 字段）
const recommendedUrls = new Set<string>();
getQidianRecommendedUrls().forEach((u) => recommendedUrls.add(u));
groups.forEach((g) =>
	g.books.forEach((b) => {
		if (b.recommend && b.url) recommendedUrls.add(b.url);
	}),
);
const recommendedUrlList = [...recommendedUrls];

// 每页展示书籍数量
const PER_PAGE = 20;
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-4">
        <div class="flex items-center gap-3 mb-3">
          <div
            class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
          >
            <Icon
              is:inline
              name="material-symbols:auto-stories"
              class="text-[1.5rem]"
            />
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
          <!-- 导出推荐配置按钮 -->
          <button
            id="qidian-export-btn"
            type="button"
            title="下载推荐列表 JSON，放到项目根目录后运行更新脚本会自动合并"
            class="ml-auto flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 bg-(--btn-regular-bg) text-(--btn-content) hover:opacity-80 cursor-pointer"
          >
            <Icon is:inline name="material-symbols:download" class="text-sm" />
            {i18n(I18nKey.qidianExport)}
          </button>
        </div>
        {description && (
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            {description}
          </p>
        )}
      </div>

      {!empty && (
        <>
          <!-- 搜索框 + 分组标签筛选 -->
          <qidian-filter class="mb-6">
            <div class="relative mb-3">
              <Icon
                is:inline
                name="material-symbols:search"
                class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
              />
              <input
                type="text"
                data-search
                placeholder={i18n(I18nKey.qidianSearch)}
                class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
              />
            </div>
            <div class="flex flex-wrap gap-2">
              <button
                data-group="recommend"
                class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                data-active
              >
                ★ {i18n(I18nKey.qidianRecommended)}
              </button>
              {groups.map((group) => (
                <button
                  data-group={group.name}
                  class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                >
                  {group.name} ({group.books.length})
                </button>
              ))}
              <button
                data-group="all"
                class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
              >
                {i18n(I18nKey.all)} ({totalCount})
              </button>
            </div>
          </qidian-filter>

          <!-- 推荐分组（客户端动态渲染） -->
          <section
            id="qidian-recommend-group"
            class="qidian-group qidian-recommend-group hidden"
            data-group-name="recommend"
          >
            <div class="flex items-center gap-2 mb-3">
              <Icon
                is:inline
                name="fa7-solid:star"
                class="text-xl text-amber-400"
              />
              <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
                {i18n(I18nKey.qidianRecommended)}
              </h2>
              <span id="qidian-recommend-count" class="text-xs text-neutral-400 dark:text-neutral-500"></span>
            </div>
            <div id="qidian-recommend-body"></div>
            <div class="qidian-pagination" data-for="recommend"></div>
          </section>

          <!-- 全部视图（客户端动态渲染为纯文本列表） -->
          <section
            id="qidian-all-group"
            class="qidian-group qidian-all-group hidden"
            data-group-name="all"
          >
            <div class="flex items-center gap-2 mb-3">
              <Icon
                is:inline
                name="material-symbols:view-list"
                class="text-xl text-(--primary)"
              />
              <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
                {i18n(I18nKey.all)} ({totalCount})
              </h2>
            </div>
            <div id="qidian-all-body"></div>
            <div class="qidian-pagination" data-for="all"></div>
          </section>

          <!-- 真实分组区块 -->
          <div class="flex flex-col gap-8">
            {groups.map((group) => (
              <section class="qidian-group" data-group-name={group.name}>
                <div class="flex items-center gap-2 mb-3">
                  <Icon
                    is:inline
                    name="material-symbols:folder-outline"
                    class="text-xl text-(--primary)"
                  />
                  <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
                    {group.name}
                  </h2>
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">
                    {group.books.length}
                  </span>
                </div>

                {/* 超过 50 本：纯文本模式 */}
                {isGroupTextMode(group.books.length) ? (
                  <div class="qidian-text-table">
                    <div class="qidian-text-row qidian-text-head">
                      <span>{i18n(I18nKey.qidianColRecommend)}</span>
                      <span>{i18n(I18nKey.qidianColStatus)}</span>
                      <span>{i18n(I18nKey.qidianColCategory)}</span>
                      <span>{i18n(I18nKey.qidianColTitle)}</span>
                      <span>{i18n(I18nKey.qidianColAuthor)}</span>
                      <span>{i18n(I18nKey.qidianColLatestChapter)}</span>
                      <span>{i18n(I18nKey.qidianColReadChapter)}</span>
                    </div>
                    {group.books.map((book) => {
                      const readToLatest = isReadToLatest(book);
                      return (
                        <div class="qidian-text-row qidian-page-item" data-search-match="true">
                          <span
                            data-recommend-toggle
                            data-url={book.url}
                            data-recommended={recommendedUrls.has(book.url) ? "true" : "false"}
                            data-recommend-text
                            title={i18n(I18nKey.qidianRecommend)}
                            class="cursor-pointer select-none"
                          >{recommendedUrls.has(book.url) ? "★" : "☆"}</span
                          >
                          <span
                            class:list={[
                              "font-bold",
                              readToLatest
                                ? "text-emerald-500 dark:text-emerald-400"
                                : "text-red-500 dark:text-red-400",
                            ]}
                            title={
                              readToLatest
                                ? i18n(I18nKey.qidianReadToLatest)
                                : i18n(I18nKey.qidianNotReadToLatest)
                            }
                          >{readToLatest ? "✓" : "✗"}</span
                          >
                          <span class="qidian-text-cat">{book.category || "-"}</span>
                          <a
                            href={book.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="qidian-text-title truncate hover:text-(--primary) transition-colors"
                            title={book.title}
                          >{book.title}</a
                          >
                          <span class="qidian-text-author truncate">{book.author || "-"}</span>
                          <span class="qidian-text-num">
                            {book.lastChapterNum ?? "-"}
                          </span>
                          <span class="qidian-text-num">
                            {book.readChapterNum ?? "-"}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  /* 50 本以下：封面卡片网格 */
                  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-4">
                    {group.books.map((book) => (
                      <div class="qidian-page-item" data-search-match="true">
                        <BookCard book={{ ...book, recommend: recommendedUrls.has(book.url) }} />
                      </div>
                    ))}
                  </div>
                )}

                {/* 分页控件（每组最多展示 PER_PAGE 本） */}
                <div class="qidian-pagination" data-for={group.name}></div>
              </section>
            ))}
          </div>

          <!-- 搜索无结果提示 -->
          <div
            class="qidian-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500"
          >
            <Icon
              is:inline
              name="material-symbols:search-off-rounded"
              class="text-4xl mb-3"
            />
            <div class="text-sm">{i18n(I18nKey.qidianNoResults)}</div>
          </div>
        </>
      )}

      <!-- 空状态：未抓取数据 -->
      {empty && (
        <div class="flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500">
          <Icon
            is:inline
            name="material-symbols:auto-stories"
            class="text-6xl mb-4 opacity-50"
          />
          <p class="text-lg">{i18n(I18nKey.qidianNoData)}</p>
          <p class="text-sm mt-2 opacity-70">
            {i18n(I18nKey.qidianNoDataHint)}
          </p>
        </div>
      )}
    </div>
  </div>

  <script is:inline define:vars={{ groups, PER_PAGE, recommendedUrlList }}>
    // 持久化推荐 URL 集合
    const RECOMMENDED_URLS = recommendedUrlList || [];

    // ========== 推荐（星星）状态：localStorage 即时 + JSON 持久化 ==========
    const REC_KEY = "qidian-recommend";

    function loadRecommend() {
      try {
        return JSON.parse(localStorage.getItem(REC_KEY) || "{}");
      } catch {
        return {};
      }
    }

    function isRecommended(url) {
      const rec = loadRecommend();
      if (url in rec) return rec[url];
      const el = document.querySelector(`[data-recommend-toggle][data-url="${url}"]`);
      if (el && el.dataset.recommended === "true") return true;
      return RECOMMENDED_URLS.includes(url);
    }

    /** 当前有效的推荐列表（localStorage 优先，持久化为空时用 JSON 兜底） */
    function getEffectiveRecommended() {
      const rec = loadRecommend();
      const result = [];
      RECOMMENDED_URLS.forEach((u) => {
        if (u in rec) { if (rec[u]) result.push(u); }
        else result.push(u);
      });
      Object.keys(rec).forEach((u) => {
        if (rec[u] && !result.includes(u)) result.push(u);
      });
      return result;
    }

    function applyRecommendState() {
      const rec = loadRecommend();
      document.querySelectorAll("[data-recommend-toggle]").forEach((el) => {
        const url = el.dataset.url;
        const on = url in rec ? rec[url] : (el.dataset.recommended === "true" || RECOMMENDED_URLS.includes(url));
        el.dataset.active = on ? "true" : "false";

        const solid = el.querySelector("[data-icon-solid]");
        const outline = el.querySelector("[data-icon-outline]");
        if (solid) solid.classList.toggle("hidden", !on);
        if (outline) outline.classList.toggle("hidden", on);

        const txt = el.matches("[data-recommend-text]")
          ? el
          : el.querySelector("[data-recommend-text]");
        if (txt) {
          txt.textContent = on ? "★" : "☆";
          txt.style.color = on ? "#fbbf24" : "";
        }
      });
    }

    document.addEventListener("click", (e) => {
      const el = e.target.closest("[data-recommend-toggle]");
      if (el) {
        e.preventDefault();
        e.stopPropagation();
        const rec = loadRecommend();
        const url = el.dataset.url;
        const on = url in rec ? rec[url] : (el.dataset.recommended === "true" || RECOMMENDED_URLS.includes(url));
        rec[url] = !on;
        localStorage.setItem(REC_KEY, JSON.stringify(rec));
        applyRecommendState();
        renderRecommendGroup();
        return;
      }
      // 导出推荐配置
      const exportBtn = e.target.closest("#qidian-export-btn");
      if (exportBtn) {
        e.preventDefault();
        const list = getEffectiveRecommended();
        const blob = new Blob(
          [JSON.stringify({ recommended: list }, null, "\t")],
          { type: "application/json" },
        );
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "qidian-recommend.json";
        a.click();
        URL.revokeObjectURL(a.href);
      }
    });

    // ========== 推荐分组（聚合所有推荐书籍） ==========
    function bookCardHtml(b) {
      const on = isRecommended(b.url);
      const lastChapter = b.lastChapter || "";
      return `<a href="${b.url}" target="_blank" rel="noopener noreferrer" class="book-card group relative block overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg hover:scale-[1.02]">
  <div class="aspect-3/4 relative overflow-hidden bg-neutral-200 dark:bg-neutral-700">
    ${b.cover ? `<img src="${b.cover}" alt="${b.title}" class="w-full h-full object-cover pointer-events-none transition-all duration-500 ease-out group-hover:scale-105" loading="lazy" decoding="async" referrerpolicy="no-referrer"/>` : ""}
    ${b.updateStatus ? `<div class="absolute top-2 left-2 px-2 py-0.5 rounded-full text-[0.65rem] text-white font-medium backdrop-blur-sm ${b.updateStatus.includes("完结") ? "bg-neutral-600/60" : b.updateStatus.includes("无更新") || b.updateStatus.includes("读完") ? "bg-emerald-600/80" : "bg-(--primary)/80"}">${b.updateStatus}</div>` : ""}
    ${b.category ? `<div class="absolute top-9 left-2 px-2 py-0.5 rounded-full text-[0.65rem] text-white font-medium bg-black/40 backdrop-blur-sm">${b.category}</div>` : ""}
    <button data-recommend-toggle data-url="${b.url}" data-recommended="${on ? "true" : "false"}" type="button" class="absolute top-2 right-2 z-20 w-7 h-7 flex items-center justify-center rounded-full bg-black/40 backdrop-blur-sm transition-transform hover:scale-110 active:scale-95 cursor-pointer">
      <span data-icon-solid class="text-amber-400 text-base ${on ? "" : "hidden"}">★</span>
      <span data-icon-outline class="text-white/85 text-base ${on ? "hidden" : ""}">☆</span>
    </button>
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 p-3">
      <h3 class="font-bold text-sm text-white line-clamp-1 drop-shadow-lg" title="${b.title}">${b.title}</h3>
      <p class="text-xs text-white/75 line-clamp-1 mt-0.5" title="${b.author || ""}">${b.author || ""}</p>
      ${lastChapter ? `<p class="text-[0.65rem] text-white/60 line-clamp-1 mt-1.5 leading-relaxed" title="${lastChapter}">${lastChapter}</p>` : ""}
    </div>
  </div>
</a>`;
    }

    function bookRowHtml(b) {
      const on = isRecommended(b.url);
      const readToLatest =
        b.lastChapterNum != null && b.readChapterNum != null
          ? b.readChapterNum >= b.lastChapterNum
          : !/有更新|未读/.test(b.updateStatus || "");
      return `<div class="qidian-text-row qidian-page-item" data-search-match="true">
  <span data-recommend-toggle data-url="${b.url}" data-recommended="${on ? "true" : "false"}" data-recommend-text class="cursor-pointer select-none">${on ? "★" : "☆"}</span>
  <span class="font-bold ${readToLatest ? "text-emerald-500 dark:text-emerald-400" : "text-red-500 dark:text-red-400"}" title="${readToLatest ? "已读至最新" : "未读至最新"}">${readToLatest ? "✓" : "✗"}</span>
  <span class="qidian-text-cat">${b.category || "-"}</span>
  <a href="${b.url}" target="_blank" rel="noopener noreferrer" class="qidian-text-title truncate hover:text-(--primary) transition-colors" title="${b.title}">${b.title}</a>
  <span class="qidian-text-author truncate">${b.author || "-"}</span>
  <span class="qidian-text-num">${b.lastChapterNum ?? "-"}</span>
  <span class="qidian-text-num">${b.readChapterNum ?? "-"}</span>
</div>`;
    }

    /** 渲染推荐分组 */
    function renderRecommendGroup() {
      const section = document.getElementById("qidian-recommend-group");
      const body = document.getElementById("qidian-recommend-body");
      const countEl = document.getElementById("qidian-recommend-count");
      if (!section || !body) return;

      const recommended = [];
      groups.forEach((g) => {
        g.books.forEach((b) => {
          if (isRecommended(b.url)) recommended.push(b);
        });
      });

      if (recommended.length === 0) {
        section.classList.add("hidden");
        return;
      }

      section.classList.remove("hidden");
      if (countEl) countEl.textContent = `(${recommended.length})`;

      const textMode = recommended.length > 50;
      if (textMode) {
        body.innerHTML =
          `<div class="qidian-text-row qidian-text-head"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>` +
          recommended.map(bookRowHtml).join("");
      } else {
        body.innerHTML = `<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-4">${recommended
          .map((b) => `<div class="qidian-page-item" data-search-match="true">${bookCardHtml(b)}</div>`)
          .join("")}</div>`;
      }

      applyRecommendState();
      initPagination();
    }

    /** 渲染「全部」视图：所有书籍合并为纯文本列表 */
    function renderAllGroup() {
      const body = document.getElementById("qidian-all-body");
      if (!body) return;
      const allBooks = [];
      groups.forEach((g) => g.books.forEach((b) => allBooks.push(b)));
      body.innerHTML =
        `<div class="qidian-text-table"><div class="qidian-text-row qidian-text-head">
<span>${"推荐"}</span><span>${"状态"}</span><span>${"类型"}</span><span>${"书名"}</span><span>${"作者"}</span><span>${"章节数"}</span><span>${"阅读数"}</span></div>` +
        allBooks.map(bookRowHtml).join("") +
        `</div>`;
      initPagination();
    }

    // ========== 分页：每组最多展示 PER_PAGE 本 ==========
    const PAGES = {};

    function initPagination() {
      document.querySelectorAll(".qidian-group").forEach((section) => {
        const key = section.dataset.groupName || section.id || "unknown";
        const items = Array.from(section.querySelectorAll(".qidian-page-item"));
        const pagEl = section.querySelector(".qidian-pagination");
        const total = items.length;
        const pages = Math.max(1, Math.ceil(total / PER_PAGE));
        if (!pagEl) return;

        const state = PAGES[key] || (PAGES[key] = { current: 1 });

        function render() {
          if (state.current > pages) state.current = pages;
          if (state.current < 1) state.current = 1;

          items.forEach((el, i) => {
            const page = Math.floor(i / PER_PAGE) + 1;
            const matched = el.dataset.searchMatch !== "false";
            el.style.display =
              page === state.current && matched ? "" : "none";
          });

          if (pages <= 1) {
            pagEl.innerHTML = `<span class="qidian-pg-info">第 1/1 页</span>`;
            return;
          }
          let html = `<button data-pg-prev class="qidian-pg-btn qidian-pg-nav" ${state.current <= 1 ? "disabled" : ""}>上一页</button>`;
          for (let p = 1; p <= pages; p++) {
            if (pages > 9 && p > 2 && p < pages - 1 && Math.abs(p - state.current) > 2) {
              if (p === 3 || p === pages - 2) html += `<span class="qidian-pg-ellipsis">…</span>`;
              continue;
            }
            html += `<button data-pg-num="${p}" class="qidian-pg-btn ${p === state.current ? "active" : ""}">${p}</button>`;
          }
          html += `<button data-pg-next class="qidian-pg-btn qidian-pg-nav" ${state.current >= pages ? "disabled" : ""}>下一页</button>`;
          html += `<span class="qidian-pg-info">第 ${state.current}/${pages} 页</span>`;
          pagEl.innerHTML = html;
        }

        pagEl.onclick = (e) => {
          const btn = e.target.closest("button");
          if (!btn || btn.disabled) return;
          if (btn.dataset.pgNum) state.current = parseInt(btn.dataset.pgNum, 10);
          else if (btn.dataset.pgPrev) state.current = Math.max(1, state.current - 1);
          else if (btn.dataset.pgNext) state.current = Math.min(pages, state.current + 1);
          render();
        };

        render();
      });
    }

    // ========== 搜索 + 分组筛选 ==========
    if (!customElements.get("qidian-filter")) {
      class QidianFilter extends HTMLElement {
        selectedGroup = "recommend"; // 默认展示推荐分组

        connectedCallback() {
          this.addEventListener("click", this.handleClick);
          const input = this.querySelector("[data-search]");
          if (input) input.addEventListener("input", () => this.applyFilters());
          this.applyFilters();
        }

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
        }

        handleClick(e) {
          const button = e.target.closest("button");
          if (!button) return;
          this.selectedGroup = button.dataset.group;
          this.querySelectorAll("button").forEach((f) => f.removeAttribute("data-active"));
          button.setAttribute("data-active", "");
          this.applyFilters();
        }

        applyFilters() {
          const container = this.closest(".card-base");
          if (!container) return;
          const input = this.querySelector("[data-search]");
          const query = (input?.value || "").toLowerCase().trim();

          container.querySelectorAll(".qidian-group").forEach((section) => {
            const groupName = section.dataset.groupName || "";
            const isRecommendGroup = groupName === "recommend";
            const isAllGroup = groupName === "all";

            // 分组匹配（修复：all 时匹配所有）
            let groupMatch = true;
            if (this.selectedGroup === "recommend") {
              groupMatch = isRecommendGroup;
            } else if (this.selectedGroup === "all") {
              groupMatch = isAllGroup;
            } else {
              groupMatch = !isRecommendGroup && !isAllGroup && this.selectedGroup === groupName;
            }

            let groupHasVisible = false;

            section.querySelectorAll(".qidian-page-item").forEach((item) => {
              const title = item.querySelector("h3, .qidian-text-title")?.textContent?.toLowerCase() || "";
              const author = item.querySelector("p, .qidian-text-author")?.textContent?.toLowerCase() || "";
              const matched = !query || title.includes(query) || author.includes(query);
              item.dataset.searchMatch = matched ? "true" : "false";
              if (matched) groupHasVisible = true;
            });

            // 显示：移除 hidden class（tailwind display:none）并清空 inline display
            if (groupMatch && groupHasVisible) {
              section.classList.remove("hidden");
              section.style.display = "";
            } else {
              section.classList.add("hidden");
              section.style.display = "none";
            }
          });

          Object.keys(PAGES).forEach((k) => (PAGES[k].current = 1));
          initPagination();

          const anyVisible = Array.from(container.querySelectorAll(".qidian-group")).some(
            (s) => s.style.display !== "none",
          );
          const emptyEl = container.querySelector(".qidian-empty");
          if (emptyEl) {
            emptyEl.classList.toggle("hidden", anyVisible);
            emptyEl.classList.toggle("flex", !anyVisible);
          }
        }
      }
      customElements.define("qidian-filter", QidianFilter);
    }

    // ========== 初始化 ==========
    function init() {
      renderAllGroup();
      applyRecommendState();
      renderRecommendGroup();
      initPagination();
    }

    document.addEventListener("swup:contentReplaced", () => setTimeout(init, 100));
    init();
  </script>
</MainGridLayout>

